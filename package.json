{
  "name": "clipvault",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first menu bar clipboard manager built with React and Electron.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "node --test",
    "start": "electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "com.clipvault.desktop",
    "productName": "ClipVault",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "mac": {
      "target": ["dmg"],
      "icon": "electron/assets/clipvault.icns",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
	"@vitejs/plugin-react": "latest",
	"vite": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "latest",
    "postcss": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^3.4.17",
    "wait-on": "latest"
  }
}
